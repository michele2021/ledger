{
  "class": "OrderReceived",
  "eventType": "ORDER_RECEIVED",
  "accountTypes": ["Client","Company"],
  "journalType": "Received",
  "txType": "Order",
  "additionalDataSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "lineItems": {
        "description": "Array of order items to process",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "price": {
              "type": "string"
            },
            "sku": {
              "type": "string"
            }
          },
          "required": [
            "price",
            "quantity"
          ]
        }
      },
      "orderNumber": {
        "type": "integer"
      },
      "totalTax": {
        "type": "string"
      }
    },
    "required": [
      "lineItems",
      "orderNumber"
    ]
  }
}