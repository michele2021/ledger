{
  "class": "ClientOrderReceived",
  "eventType": "CLIENT_ORDER_RECEIVE",
  "accountTypes": ["Client"],
  "journalType": "Received",
  "txType": "Order",
  "additionalDataSchema": {
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "type": "object",
    "properties": {
      "tokens": {
        "description": "Array of tokens to process",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "email",
            "name",
            "quantity"
          ]
        }
      },
      "sku": {
        "type": "string"
      },
      "cardProgram": {
        "type": "string"
      },
      "orderTitle": {
        "type": "string"
      },
      "orderId": {
        "description": "The unique identifier of order",
        "type": "integer",
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "tokens",
      "sku",
      "cardProgram",
      "orderTitle",
      "orderId"
    ]
  }
}