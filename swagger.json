    "/accounting/journals/from-template" : {
      "post" : {
        "tags" : [ "TemplateExecutionResource" ],
        "summary" : "Execute template. JSON should be passed as body.",
        "operationId" : "execute",
        "requestBody" : {
          "description" : "Ledger JSON message to forward to the processing queue.",
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/QueueMessageDTO"
              },
              "examples" : {
                "PAYMENT_MATCH" : {
                  "description" : "Match an order and a payment",
                  "value" : {
                    "type" : "PAYMENT_RECEIVED",
                    "accountCode" : "DEFAULT",
                    "amount" : {
                      "quantity" : 150.0,
                      "currencyCode" : "EUR"
                    },
                    "additionalData" : {
                      "bankAccountCode" : "ItalyClients1",
                      "discountAmount" : 10,
                      "description" : "Payment from DEFAULT, discount applied"
                    },
                    "source" : "FRONT_END_APP"
                  }
                },
                "PAYMENT_RECEIVED_CORRECTION" : {
                  "description" : "Posts a reverse journal of PAYMENT_RECEIVED",
                  "value" : {
                    "type" : "PAYMENT_RECEIVED_CORRECTION",
                    "accountCode" : "DEFAULT",
                    "amount" : {
                      "quantity" : 150.0,
                      "currencyCode" : "EUR"
                    },
                    "additionalData" : {
                      "bankAccountCode" : "ItalyClients1",
                      "discountAmount" : 10,
                      "description" : "Correction previous erroneous posting."
                    },
                    "source" : "FRONT_END_APP"
                  }
                },
                "CLIENT_FEE_PAYOUT" : {
                  "description" : "Client fee payout",
                  "value" : {
                    "type" : "CLIENT_FEE_PAYOUT",
                    "accountCode" : "DEFAULT",
                    "amount" : {
                      "quantity" : 150.0,
                      "currencyCode" : "EUR"
                    },
                    "source" : "FRONT_END_APP"
                  }
                }
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "500" : {
            "description" : "Internal server error or unhandled error",
