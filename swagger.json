  "components" : {
    "schemas" : {
      "AccountDTO" : {
        "required" : [ "accountCode", "accountTypeCode", "description" ],
        "type" : "object",
        "properties" : {
          "accountCode" : {
            "type" : "string",
            "description" : "Account code (alphanumeric)"
          },
          "accountTypeCode" : {
            "type" : "string",
            "description" : "Account type code",
            "enum" : [ "Client", "Company", "BankAccount", "Issuer", "VirtualIban" ]
          },
          "parentAccountCode" : {
            "type" : "string",
            "description" : "Parent account code"
          },
          "parentAccountTypeCode" : {
            "type" : "string",
            "description" : "Parent account type code",
            "enum" : [ "Client", "Company", "BankAccount", "Issuer", "VirtualIban" ]
          },
          "description" : {
            "type" : "string",
            "description" : "Account description"
          },
          "accountProperties" : {
            "type" : "array",
            "description" : "Account properties",
            "items" : {
              "$ref" : "#/components/schemas/AccountPropertyDTO"
            }
          },
          "clientDetails" : {
            "$ref" : "#/components/schemas/ClientDetailsDTO"
          },
          "testAccount" : {
            "type" : "boolean",
            "description" : "Is this account a test account"
          },
          "createTestAccount" : {
            "type" : "boolean",
            "description" : "Create also a corresponding _TEST account (only if this account is not a test account)"
          },
          "userName" : {
            "type" : "string",
            "description" : "User that is creating the account"
          }
        }
      },
      "AccountPropertyDTO" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "enum" : [ "TimeZone", "ExpiryMonths", "LowBalanceNotificationThresholdEUR", "LowBalanceNotificationThresholdGBP", "LowBalanceNotificationThresholdUSD", "AccountCurrency", "ScheduledReports", "ExpiryMode", "IsSale" ]
          },
          "value" : {
            "type" : "string"
          }
        },
        "description" : "Account properties"
      },
      "ClientDetailsDTO" : {
        "required" : [ "cityName", "contactRef", "country", "email", "postalCode", "streetAddress", "telephoneNumber" ],
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "description" : "Client email"
          },
          "streetAddress" : {
            "type" : "string",
            "description" : "Street address"
          },
          "telephoneNumber" : {
            "type" : "string",
            "description" : "Telephone Number"
          },
          "cityName" : {
            "type" : "string",
            "description" : "City name"
          },
          "country" : {
            "type" : "string",
            "description" : "Country"
          },
          "contactRef" : {
            "type" : "string",
            "description" : "Contact reference"
          },
          "postalCode" : {
            "type" : "string",
            "description" : "Postal code"
          }
        },
        "description" : "Client Account details"
      },
      "JsonNode" : {
        "type" : "object",
        "description" : "Additional data, exact format depends on the message type."
      },
      "LoginRequest" : {
        "required" : [ "username" ],
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          }
        }
      },
      "AttachmentMetaDTO" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          },
          "filename" : {
            "type" : "string"
          },
          "contentType" : {
            "type" : "string"
          },
          "textContent" : {
            "type" : "string"
          },
          "uri" : {
            "type" : "string"
          },
          "sha256" : {
            "type" : "string"
          },
          "size" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "description" : "Metadata regarding journal attachments."
      },
      "QueueMessageAmountDTO" : {
        "required" : [ "currencyCode", "quantity" ],
        "type" : "object",
        "properties" : {
          "quantity" : {
            "minimum" : 0,
            "type" : "number",
            "description" : "Amount to be booked.",
            "example" : 123.45
          },
          "currencyCode" : {
            "minLength" : 3,
            "type" : "string",
            "description" : "Currency ISO code.",
            "example" : "EUR"
          }
        },
        "description" : "Amount to be booked."
      },
      "QueueMessageDTO" : {
        "required" : [ "accountCode", "source", "type" ],
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "description" : "Message type, determine how some other fields are handled.",
            "enum" : [ "PAYMENT_RECEIVED", "PAYMENT_MATCH", "JOURNAL_POST" ]
          },
          "accountCode" : {
            "type" : "string",
            "description" : "Code of account, account must exist in database."
          },
          "amount" : {
            "$ref" : "#/components/schemas/QueueMessageAmountDTO"
          },
          "uuid" : {
            "type" : "string",
            "description" : "A unique identifier. Our recommended and preferred format is UUID V4."
          },
          "txReference" : {
            "type" : "string",
            "description" : "Transaction reference"
          },
          "additionalData" : {
            "$ref" : "#/components/schemas/JsonNode"
          },
          "journalInfo" : {
            "type" : "array",
            "description" : "Metadata regarding journal attachments.",
            "items" : {
              "$ref" : "#/components/schemas/AttachmentMetaDTO"
            }
          },
          "source" : {
            "type" : "string",
            "description" : "Source of message, must be FRONT_END_APP",
            "enum" : [ "FRONT_END_APP" ]
          }
        }
      },
      "AuthUser" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "username" : {
            "type" : "string"
          },
          "companyAccountId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "companyAccountCode" : {
            "type" : "string"
          },
          "roles" : {
            "uniqueItems" : true,
