# Environments for docker images
# =====================================================================

# PostgreSQL
# =====================================================================
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="docker"
DATABASES_TO_CREATE="accounting,balance,balancetest"

# AWS Local-Stack
# =====================================================================
DEBUG=0
AWS_PORT="4566"
SERVICES="s3,sqs,sns,dynamodb"
HOSTNAME_EXTERNAL=localstack
DATA_DIR="/tmp/localstack/data"
LOCALSTACK_URL="http://localstack:${AWS_PORT}"

AWS_REGION="eu-central-1"
AWS_SQS_ACCOUNTING_QUEUE="accounting-development.fifo"
AWS_SQS_ACCOUNTING_BALANCE_QUEUE="accountingbalance-development.fifo"
AWS_ACCESS_KEY_ID="default_access_key"
AWS_SECRET_ACCESS_KEY="default_secret_key"
AWS_SNS_SYSTEM_NOTIFICATIONS_ARN="arn:aws:sns:eu-central-1:000000000000:ledger-system-notifications-development"
AWS_SNS_FINANCIAL_NOTIFICATIONS_ARN="arn:aws:sns:eu-central-1:000000000000:ledger-financial-notifications-development"
DSR_SNS_NOTIFICATIONS_ENABLED="true"

#MONAVATE_API_KEY="default_monavate_api_key"
#MONAVATE_URL="default_monavate_url"
COGNITO_KEY_N1="cognito_key_n1"
COGNITO_KEY_N2="cognito_key_n2"
COGNITO_KEY_KID1="cognito_key_kid1"
COGNITO_KEY_KID2="cognito_key_kid2"
COGNITO_KEY_E="cognito_key_e"

# Ledger
# =====================================================================

API_KEY="api_key"
ALLOWED_ORIGINS_APP="http://localhost:3000"
ALLOWED_ORIGINS_ADMIN="http://localhost:3000"
DEBUG_PORT="8090"
PG_PORT=${POSTGRES_PORT}
PG_HOST="postgresql_db"
PG_DB_NAME="accounting"
ENVIRONMENT="development"
ACC_DB_USERNAME="app"
ACC_DB_PASSWORD="password"
ACCOUNTING_HTTP_APP="8080"
ACCOUNTING_HTTP_ADMIN="8081"
AWS_ENDPOINT=${LOCALSTACK_URL}
AWS_DYNAMO_DB_MESSAGES_TABLE_NAME="ledger-messages-development"
AWS_SQS_ACCOUNTING_QUEUE="accounting-development.fifo"
AWS_SQS_ACCOUNTING_BALANCE_QUEUE="accountingbalance-development.fifo"
# =====================================================================





